index 0745678..314c52e 100644
--- a/src/transform/castlefrustum.pas
+++ b/src/transform/castlefrustum.pas
@@ -227,9 +227,103 @@ type
   end;
   PFrustum = ^TFrustum;
 
+{ Conservative overlap with the prism formed by extruding the first four
+  (near) frustum points in both directions along LightDirection.
+  False proves that a directional shadow cannot cross the near rectangle.
+  Degenerate or numerically ambiguous planes return possible overlap.
+  This helper does not depend on a graphics context. }
+function Box3DIntersectsDirectionalNearPrism(const Box: TBox3D;
+  const NearPoints: TFrustumPoints; const LightDirection: TVector3): Boolean;
+
 implementation
 
-{$ifndef FPC}uses CastleUtils;{$endif}
+uses Math {$ifndef FPC}, CastleUtils {$endif};
+
+function Box3DIntersectsDirectionalNearPrism(const Box: TBox3D;
+  const NearPoints: TFrustumPoints; const LightDirection: TVector3): Boolean;
+const
+  ParallelTolerance = 1.0E-5;
+  { Eight Single ulps at the input coordinate scale cover represented near
+    corners and caster bounds. Ambiguity may cost z-fail, never a lost shadow. }
+  InputTolerance = 8 * 1.1920928955078125E-7;
+var
+  Points: array [0..3] of TVector3Double;
+  Light, NearNormal, Center, Edge, Normal, Support: TVector3Double;
+  LightLength, NearLength, NormalLength, Scale, Margin, CenterSide: Double;
+  I, J: Integer;
+  PlaneUsable: Boolean;
+begin
+  Scale := 1;
+  for I := 0 to 2 do
+  begin
+    if IsNan(LightDirection[I]) or IsInfinite(LightDirection[I]) or
+       IsNan(Box.Data[0][I]) or IsInfinite(Box.Data[0][I]) or
+       IsNan(Box.Data[1][I]) or IsInfinite(Box.Data[1][I]) then
+      Exit(true);
+    Scale := Max(Scale, Max(Abs(Box.Data[0][I]), Abs(Box.Data[1][I])));
+  end;
+  if Box.IsEmpty then
+    Exit(false);
+  Center := TVector3Double.Zero;
+  for I := 0 to 3 do
+  begin
+    for J := 0 to 2 do
+    begin
+      if IsNan(NearPoints[I][J]) or IsInfinite(NearPoints[I][J]) then
+        Exit(true);
+      Points[I].Data[J] := NearPoints[I][J];
+      Scale := Max(Scale, Abs(Points[I][J]));
+    end;
+    Center := Center + Points[I] * 0.25;
+  end;
+  Light := Vector3Double(LightDirection);
+  LightLength := Light.Length;
+  if LightLength = 0 then
+    Exit(true);
+  Light := Light / LightLength;
+  NearNormal := TVector3Double.CrossProduct(Points[0] - Points[1],
+    Points[2] - Points[1]);
+  NearLength := NearNormal.Length;
+  if NearLength = 0 then
+    Exit(true);
+  if Abs(TVector3Double.DotProduct(NearNormal, Light)) <=
+     ParallelTolerance * NearLength then
+    Exit(true);
+
+  for I := 0 to 3 do
+  begin
+    Edge := Points[(I + 1) mod 4] - Points[I];
+    { Cross differences directly: adding a unit light to a large coordinate
+      can round away the light before TrianglePlane even sees it. }
+    Normal := TVector3Double.CrossProduct(Edge, Light);
+    NormalLength := Normal.Length;
+    if NormalLength <= 1.0E-14 * Edge.Length then
+      Continue;
+    Margin := InputTolerance * Scale * NormalLength;
+    CenterSide := TVector3Double.DotProduct(Normal, Center - Points[I]);
+    if Abs(CenterSide) <= Margin then
+      Continue;
+    if CenterSide > 0 then
+      Normal := -Normal;
+
+    { Rounding can make a near rectangle slightly nonplanar. Only retain a
+      separating plane that encloses every represented near corner. }
+    PlaneUsable := true;
+    for J := 0 to 3 do
+      if TVector3Double.DotProduct(Normal, Points[J] - Points[I]) > Margin then
+        PlaneUsable := false;
+    if not PlaneUsable then
+      Continue;
+    for J := 0 to 2 do
+      if Normal[J] >= 0 then
+        Support.Data[J] := Box.Data[0][J]
+      else
+        Support.Data[J] := Box.Data[1][J];
+    if TVector3Double.DotProduct(Normal, Support - Points[I]) > Margin then
+      Exit(false);
+  end;
+  Result := true;
+end;
 
 constructor TFrustum.Init(const Matrix: TMatrix4);
 begin
