-procedure MatrixToWebGLAdd(const M: TMatrix2; const List: IJSFloat32Array; const Offset: Integer);
+{ The single-precision records store contiguous scalars; matrix Data is
+  already column-major. Keep this assumption explicit when changing their
+  layout. Each result owns a copy, so later source edits or WASM memory growth
+  cannot change or detach an earlier returned uniform array. }
+{$if (SizeOf(TMatrix2) <> 4 * SizeOf(Single)) or
+     (SizeOf(TMatrix3) <> 9 * SizeOf(Single)) or
+     (SizeOf(TMatrix4) <> 16 * SizeOf(Single)) or
+     (SizeOf(TVector2) <> 2 * SizeOf(Single)) or
+     (SizeOf(TVector3) <> 3 * SizeOf(Single)) or
+     (SizeOf(TVector4) <> 4 * SizeOf(Single)) or
+     (SizeOf(Int32) <> SizeOf(Single))}
+  {$fatal WebGL bulk conversion requires contiguous single-precision records}
+{$endif}
+
+function WebGLByteCount(const Count, Components: Cardinal): Cardinal;
 var
-  Col, Row: TMatrix2.TIndex;
+  Bytes: QWord;
 begin
-  { Convert to a list of values in column-major order, as expected by WebGL:
-    https://developer.mozilla.org/en-US/docs/Web/API/WebGLRenderingContext/uniformMatrix }
-  for Col := Low(Col) to High(Col) do
-    for Row := Low(Row) to High(Row) do
-      List[Offset + Col * 2 + Row] := M[Col, Row];
+  Bytes := QWord(Count) * Components * SizeOf(Single);
+  { JOB passes the byte length through a signed wasm32 NativeInt. Reject the
+    range that JavaScript would receive as negative, before allocating. }
+  if Bytes > High(LongInt) then
+    raise ERangeError.Create('WebGL uniform array exceeds the JOB signed byte range');
+  Result := Cardinal(Bytes);
 end;
 
